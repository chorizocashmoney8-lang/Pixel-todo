{
  "name": "pixel-todo-desktop",
  "version": "1.0.0",
  "description": "Pixel Todo 桌面版:待办清单 + 番茄钟",
  "main": "main/main.js",
  "scripts": {
    "start": "node run-dev.js",
    "test": "node --test",
    "dist": "node --use-system-ca node_modules/electron-builder/cli.js --win --x64 --config.electronDist=node_modules/electron/dist"
  },
  "type": "commonjs",
  "private": true,
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "local.pixel-todo",
    "productName": "Pixel Todo",
    "directories": {
      "output": "dist-build"
    },
    "files": [
      "main/**",
      "preload/**",
      "renderer/**",
      "assets/**",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "include": "build/installer.nsh",
      "createDesktopShortcut": false,
      "installerLanguages": [
        "zh_CN"
      ],
      "perMachine": false,
      "runAfterFinish": true,
      "allowToChangeInstallationDirectory": true,
      "customNsisResources": {
        "version": "3.4.1",
        "url": "https://github.com/electron-userland/electron-builder-binaries/releases/download/nsis-resources-3.4.1/nsis-resources-3.4.1.7z",
        "checksum": "Dqd6g+2buwwvoG1Vyf6BHR1b+25QMmPcwZx40atOT57gH27rkjOei1L0JTldxZu4NFoEmW4kJgZ3DlSWVON3+Q=="
      }
    }
  }
}
